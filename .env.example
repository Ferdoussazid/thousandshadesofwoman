# Supabase — create a project at https://supabase.com, then run supabase/schema.sql
# in the SQL editor and copy these values from Project Settings > API.
# The site works without them (it falls back to a built-in catalogue),
# but newsletter/contact submissions are only stored when Supabase is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
